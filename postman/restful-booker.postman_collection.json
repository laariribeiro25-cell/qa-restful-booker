    {
      "name": "Criar reserva",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"A criação retorna um ID numérico\", function () {\r\n    pm.response.to.have.status(200);\r\n\r\n    const resposta = pm.response.json();\r\n    pm.expect(resposta.bookingid).to.be.a(\"number\");\r\n    pm.collectionVariables.set(\"bookingId\", resposta.bookingid);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstname\": \"Mariana\",\r\n  \"lastname\": \"Teste QA\",\r\n  \"totalprice\": 180,\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": {\r\n    \"checkin\": \"2027-03-20\",\r\n    \"checkout\": \"2027-03-23\"\r\n  },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
