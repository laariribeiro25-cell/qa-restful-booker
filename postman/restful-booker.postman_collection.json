  "item": [
    {
      "name": "Listar reservas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"A consulta retorna HTTP 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"A lista contém reservas com bookingid numérico\", function () {\r\n    const reservas = pm.response.json();\r\n\r\n    pm.expect(reservas).to.be.an(\"array\").that.is.not.empty;\r\n\r\n    reservas.forEach(function (reserva) {\r\n        pm.expect(reserva.bookingid).to.be.a(\"number\");\r\n    });\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://restful-booker.herokuapp.com/booking",
          "protocol": "https",
          "host": [
            "restful-booker",
            "herokuapp",
            "com"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Gerar token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"A autenticação retorna um token válido no formato esperado\", function () {\r\n    pm.response.to.have.status(200);\r\n\r\n    const resposta = pm.response.json();\r\n    pm.expect(resposta.token).to.be.a(\"string\").and.not.be.empty;\r\n    pm.collectionVariables.set(\"bookerToken\", resposta.token);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
