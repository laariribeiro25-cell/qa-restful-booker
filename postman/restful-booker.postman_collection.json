    {
      "name": "Consultar reserva por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"A consulta retorna o nome e o preço da reserva\", function () {\r\n    pm.response.to.have.status(200);\r\n\r\n    const reserva = pm.response.json();\r\n    pm.expect(reserva.firstname).to.eql(\"Mariana\");\r\n    pm.expect(reserva.totalprice).to.eql(180);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://restful-booker.herokuapp.com/booking/{{bookingId}}",
          "protocol": "https",
          "host": [
            "restful-booker",
            "herokuapp",
            "com"
          ],
          "path": [
            "booking",
            "{{bookingId}}"
          ]
        }
      },
      "response": []
